# Local development. For Vercel use your hosted PostgreSQL pooled URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true&statement_cache_size=0"
# Direct connection used by Prisma migrations; your provider supplies it.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Generate a unique random secret: npm run env:setup creates one locally.
BETTER_AUTH_SECRET=""
